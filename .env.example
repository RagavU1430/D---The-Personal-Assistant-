APP_NAME=D - The personal Assistant
START_WITH_WINDOWS=true
BACKGROUND_MODE=true
LAUNCH_UI_AT_STARTUP=false
ENABLE_COMPUTER_CONTROL=true
AUTONOMOUS_MODE=false
APP_VERSION=0.1.0
APP_ENV=development
HOST=127.0.0.1
PORT=8001
DATABASE_URL=sqlite:///./d.db
AI_PROVIDER=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=
AI_MODELS=
AI_TIMEOUT_SECONDS=12
PROVIDER_COOLDOWN_SECONDS=30
AUTONOMY_LEVEL=1

# Custom AI providers (OpenAI-compatible endpoints)
# Format: "name1=base_url1,api_key1,model1|name2=base_url2,api_key2,model2"
# Example: "ollama=http://localhost:11434/v1,,llama3.2|lmstudio=http://127.0.0.1:1234/v1,,gpt-oss-20b|custom=https://my-api.example.com/v1,sk-xxx,my-model"
CUSTOM_AI_PROVIDERS=
ENABLE_BROWSER=false
ENABLE_COMPUTER_CONTROL=false
ENABLE_TERMINAL=false
ENABLE_VOICE=false
ENABLE_FILE_TOOLS=false
APPROVED_FILE_ROOTS=C:/Users/YourName/Desktop/Projects
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
